"""Type stubs for mfengine._core (M7). Checked against the module by
tests/bindings/test_mfengine_stubs.py (names both ways, and mypy's stubtest)."""

import enum
import os
from collections.abc import Iterable, Iterator
from typing import Final, Self, final

_Path = str | os.PathLike[str]

# --- Errors ------------------------------------------------------------------------

class MarketForgeError(Exception): ...
class InvariantViolation(MarketForgeError): ...
class SequenceError(InvariantViolation): ...
class EngineFailed(MarketForgeError): ...

class JournalError(MarketForgeError):
    kind: JournalErrorKind

class SnapshotError(MarketForgeError): ...
class ConfigError(MarketForgeError): ...
class ParseError(MarketForgeError): ...

# --- Enums -------------------------------------------------------------------------

class Side(enum.Enum):
    BUY = 0
    SELL = 1

class OrderType(enum.Enum):
    LIMIT = 0
    MARKET = 1

class TimeInForce(enum.Enum):
    GTC = 0
    IOC = 1
    FOK = 2
    DAY = 3

class SessionState(enum.Enum):
    PRE_OPEN = 0
    CONTINUOUS = 1
    HALTED = 2
    CLOSED = 3

class StpMode(enum.Enum):
    CANCEL_NEWEST = 0
    CANCEL_OLDEST = 1
    CANCEL_BOTH = 2

class RejectReason(enum.Enum):
    INVALID_PRICE = 0
    INVALID_QTY = 1
    INVALID_ORDER_TYPE = 2
    DUPLICATE_ORDER_ID = 3
    UNKNOWN_ORDER = 4
    NO_LIQUIDITY = 5
    FOK_NOT_FILLABLE = 6
    POST_ONLY_WOULD_CROSS = 7
    REPLACE_QTY_TOO_LOW = 8
    MARKET_CLOSED = 9
    KILL_SWITCH = 10
    RATE_LIMIT = 11
    MAX_QTY = 12
    PRICE_BAND = 13
    MAX_NOTIONAL = 14
    MAX_OPEN_ORDERS = 15
    POSITION_LIMIT = 16
    INSUFFICIENT_CREDIT = 17

class CancelReason(enum.Enum):
    USER = 0
    UNFILLED = 1
    SELF_TRADE = 2
    EXPIRED = 3
    KILL_SWITCH = 4

class AdminKind(enum.Enum):
    INSTRUMENT_LIMITS = 0
    ACCOUNT_LIMITS = 1
    KILL_SWITCH = 2

class AdminRejectReason(enum.Enum):
    INVALID_TRANSITION = 0
    INVALID_LIMITS = 1
    INVALID_KILL_SWITCH = 2

class Liquidity(enum.Enum):
    MAKER = 0
    TAKER = 1

class JournalErrorKind(enum.Enum):
    IO = 0
    BAD_HEADER = 1
    TRUNCATED = 2
    CORRUPT = 3
    SEQUENCE_GAP = 4
    TIMESTAMP_BACKWARDS = 5

