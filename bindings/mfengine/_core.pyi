# --- Engine and batches ---------------------------------------------------------------

@final
class CommandBatch:
    def __init__(self) -> None: ...
    def append(self, command: _Command, timestamp: int = 0) -> None: ...
    def extend(self, items: Iterable[tuple[_Command, int]]) -> None: ...
    def clear(self) -> None: ...
    def __len__(self) -> int: ...

@final
class EventBatch:
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> _Event: ...
    def __iter__(self) -> Iterator[_Event]: ...
    def events_of(self, command: int) -> list[_Event]: ...
    @property
    def offsets(self) -> list[int]: ...
    @property
    def command_count(self) -> int: ...

@final
class Engine:
    def __init__(self) -> None: ...
    def process(self, command: _Command, timestamp: int = 0) -> list[_Event]: ...
    def process_batch(self, batch: CommandBatch) -> EventBatch: ...
    def best_bid(self) -> int | None: ...
    def best_ask(self) -> int | None: ...
    def depth(self, side: Side, levels: int | None = None) -> list[tuple[int, int, int]]: ...
    def level_orders(self, side: Side, price: int) -> list[int]: ...
    def order(self, order_id: int) -> OrderView | None: ...
    @property
    def order_count(self) -> int: ...
    @property
    def last_seq_no(self) -> int | None: ...
    @property
    def last_timestamp(self) -> int | None: ...
    @property
    def session(self) -> SessionState: ...
    def position(self, account_id: int) -> int: ...
    def positions(self) -> dict[int, int]: ...
    def exposure(self, account_id: int) -> Exposure: ...
    def check_invariants(self) -> None: ...
    @property
    def failed(self) -> bool: ...
    def snapshot(self, *, last_timestamp: int | None = None, journal_offset: int = 0) -> Snapshot: ...
    @staticmethod
    def from_snapshot(snapshot: Snapshot) -> Engine: ...

