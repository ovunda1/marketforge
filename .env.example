# Copy to .env (git-ignored) and fill in. docker compose reads it; nothing here is
# baked into an image.
POSTGRES_PASSWORD=change-me
# Optional: only the backtest worker receives it (Tiingo data downloads).
TIINGO_API_KEY=
# Demo mode (M11): self-service practice accounts from the dashboard. On by default in
# docker-compose.yml (a local demo); set to 0 to turn them off.
MF_DEMO_MODE=1
